# ==============================================================================
# FlexyRide Corporate - Environment Configuration Template (.env.example)
# Copy this file to .env and replace placeholder values with your credentials.
# ==============================================================================

# Django Core Settings
DEBUG=True
SECRET_KEY=django-insecure-+yi0h8#m6kgfipb-tfeyy7iglz*xo_)2y9+o@3e5eq2j(^cxlg
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL Production / Local)
# ------------------------------------------------------------------------------
# 12-factor DATABASE_URL format:
# DATABASE_URL=postgresql://<db_user>:<db_password>@<db_host>:<db_port>/<db_name>
DATABASE_URL=postgresql://postgres:raven_db@localhost:5432/flexyride_corporate

# Alternatively, discrete credentials:
DB_ENGINE=django.db.backends.postgresql
DB_NAME=flexyride_corporate
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=600

# ------------------------------------------------------------------------------
# Google Maps API Configuration
# Required for: Maps JavaScript SDK, Places Autocomplete, Fleet Routing & Geocoding
# ------------------------------------------------------------------------------
# Get your API key at: https://console.cloud.google.com/google/maps-apis/overview
# Ensure you enable:
#   1. Maps JavaScript API
#   2. Places API (New)
#   3. Geocoding API
#   4. Directions API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ------------------------------------------------------------------------------
# Email Service Configuration (SMTP / Transactional Email)
# Used for: RFQ notifications, dispatch updates, booking receipts, password resets
# ------------------------------------------------------------------------------
# For development/testing on terminal output, use:
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For production SMTP delivery, use:
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# FlexyRide Production Mail Server Example:
#   EMAIL_HOST=mail.flexyridegh.com
#   EMAIL_PORT=465
#   EMAIL_USE_TLS=False
#   EMAIL_USE_SSL=True
#   EMAIL_HOST_USER=noreply@flexyridegh.com
#   EMAIL_HOST_PASSWORD=your_password_here
#
# Gmail Example:
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_PORT=587
#   EMAIL_USE_TLS=True
#   EMAIL_USE_SSL=False
#   EMAIL_HOST_USER=your_email@gmail.com
#   EMAIL_HOST_PASSWORD=your_16_char_app_password
EMAIL_HOST=mail.flexyridegh.com
EMAIL_PORT=465
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True
EMAIL_HOST_USER=noreply@flexyridegh.com
EMAIL_HOST_PASSWORD=your_smtp_password
DEFAULT_FROM_EMAIL=FlexyRide Corporate <noreply@flexyridegh.com>
SERVER_EMAIL=FlexyRide Corporate <noreply@flexyridegh.com>

# ------------------------------------------------------------------------------
# SMS / WhatsApp Notification Gateway (Optional Placeholders)
# ------------------------------------------------------------------------------
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=your_africastalking_api_key
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number
