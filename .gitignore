# ==============================================================================
# FlexyRide Corporate - Git Ignore Rules
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Django specific
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
*.sqlite3
media/
media_root/
staticfiles/
static_root/

# Environment Variables & Secrets
.env
*.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# Type checkers and linters
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/

# Celery
celerybeat-schedule
celerybeat-schedule.*
celerybeat.pid

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor artifacts
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

